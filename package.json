{
  "name": "coros-mcp",
  "private": true,
  "description": "COROS training plan sync — npm scripts wrap the Python CLI",
  "scripts": {
    "sync:setup": "bash scripts/sync-setup.sh",
    "sync:web": "bash scripts/sync-web.sh",
    "sync": "bash scripts/sync-run.sh sync",
    "sync:plan": "bash scripts/sync-plan.sh",
    "sync:import": "bash scripts/sync-run.sh import-plan",
    "plan:serve": "bash scripts/serve-plan.sh",
    "weekly-api": ".venv/bin/coros-mcp weekly-api",
    "coach:dev": "npm --prefix strength-pr-tracker run dev",
    "auth": ".venv/bin/coros-mcp auth"
  }
}

