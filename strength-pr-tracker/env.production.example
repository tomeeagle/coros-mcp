# Production Environment Variables
# Copy this to Vercel dashboard environment variables

# Database
MONGODB_URI=your_mongodb_connection_string

# Strava API Configuration
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Production URLs (replace with your actual Vercel domain)
STRAVA_REDIRECT_URI=https://your-app.vercel.app/api/strava/callback
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Note: In Vercel, you'll set these in the project dashboard
# under Settings > Environment Variables
