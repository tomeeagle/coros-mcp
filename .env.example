# Copy to .env and fill in (never commit .env)
COROS_EMAIL=you@example.com
COROS_PASSWORD=your-password
COROS_REGION=eu

# Optional: use a pre-issued token instead of email/password
# COROS_ACCESS_TOKEN=

# Optional Google Calendar sync (pip install -e '.[calendar]')
# GOOGLE_CALENDAR_CLIENT_SECRET=~/.config/coros-mcp/google-calendar-client.json
# GOOGLE_CALENDAR_TOKEN=~/.config/coros-mcp/google-calendar-token.json
# GOOGLE_CALENDAR_ID=primary
